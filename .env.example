# ==============================================================================
# Portfolio Environment Configuration Template (.env.example)
# Duplicate this file as .env.local and populate with your credentials.
# NEVER commit .env.local to Git.
# ==============================================================================

# 1. MongoDB Atlas Connection URI (Server-Side Only)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_DB=portfolio

# 2. Cloudinary Credentials (Server-Side Only)
# Sourced from Cloudinary Dashboard: Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. Administrator Authorization Allowlist (Server-Side Only)
# Comma-separated list of authorized admin email addresses
ADMIN_EMAILS=admin@example.com

# 4. Optional Initial Administrator Password (Server-Side Only)
# Used to authenticate or seed the initial administrator account
ADMIN_PASSWORD=change_this_to_a_secure_password