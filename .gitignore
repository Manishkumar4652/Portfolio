# env files (allow .env.example placeholder template only)
.env*
!.env.example

# ide
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# vercel
.vercel

# typescript & build
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo

